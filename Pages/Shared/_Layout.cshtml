@using System.Globalization
@inject IConfiguration Config
@{
    // Sale deadline: explicit date from config, else the current weekly promo window (ends Sunday night UTC)
    DateTime saleEndUtc;
    if (!DateTime.TryParse(Config["Sale:EndsAt"], CultureInfo.InvariantCulture,
            DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out saleEndUtc)
        || saleEndUtc <= DateTime.UtcNow)
    {
        var now = DateTime.UtcNow;
        var daysUntilMonday = ((int)DayOfWeek.Monday - (int)now.DayOfWeek + 7) % 7;
        if (daysUntilMonday == 0) daysUntilMonday = 7;
        saleEndUtc = now.Date.AddDays(daysUntilMonday);
    }
    var promoCode = Config["Promo:Code"] ?? "WELCOME10";
    var promoPct  = Config["Promo:Percent"] ?? "10";
    var currentPage = (ViewContext.RouteData.Values["page"] as string ?? "").ToLowerInvariant();
    string NavActive(string page) => currentPage == page.ToLowerInvariant() ? "active" : "";
    var metaDescription = ViewData["Description"] as string
        ?? "Premium dog beds, grooming and paw care loved by 128+ verified dog parents. Free shipping on every order, 30-day money-back guarantee.";
    var siteOrigin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var ogImage = siteOrigin + (ViewData["OgImage"] as string ?? "/images/IMG_1046.jpeg");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PET HEAVEN</title>
    <meta name="description" content="@metaDescription" />
    <meta property="og:site_name" content="PET HEAVEN" />
    <meta property="og:title" content="@ViewData["Title"] — PET HEAVEN" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@ogImage" />
    <meta name="theme-color" content="#1a3828" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <!-- Meta Pixel Code -->
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2330592530797423');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2330592530797423&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
</head>
<body>

    <!-- Announcement bar -->
    <div class="announcement-bar">
        <span><i class="bi bi-fire me-1" style="color:#f97316;"></i><strong>Sale — up to 70% off</strong></span>
        <span class="countdown-pill" id="saleCountdown" data-end="@saleEndUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")">
            <i class="bi bi-stopwatch me-1"></i>Ends in <span id="saleCountdownVal">…</span>
        </span>
        <span class="d-none d-md-inline"><i class="bi bi-truck me-1"></i>Free shipping on every order</span>
        <span class="d-none d-lg-inline"><i class="bi bi-arrow-repeat me-1"></i>30-day money-back guarantee</span>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <svg class="logo-mark" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PET HEAVEN logo">
                    <defs>
                        <linearGradient id="logoBg" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#2d6a4f"/>
                            <stop offset="1" stop-color="#1a3828"/>
                        </linearGradient>
                    </defs>
                    <rect x="1" y="1" width="46" height="46" rx="13" fill="url(#logoBg)"/>
                    <ellipse cx="24" cy="9.6" rx="7.6" ry="2.7" fill="none" stroke="#ffc93c" stroke-width="2.4" stroke-linecap="round"/>
                    <path d="M24 39c-4.9 0-8.4-2.7-8.4-6.4 0-3.1 3.6-7.8 8.4-7.8s8.4 4.7 8.4 7.8C32.4 36.3 28.9 39 24 39z" fill="#fff"/>
                    <ellipse cx="13.9" cy="24.2" rx="3.2" ry="4.3" fill="#fff" transform="rotate(-20 13.9 24.2)"/>
                    <ellipse cx="20.4" cy="19.8" rx="3.2" ry="4.5" fill="#fff" transform="rotate(-7 20.4 19.8)"/>
                    <ellipse cx="27.6" cy="19.8" rx="3.2" ry="4.5" fill="#fff" transform="rotate(7 27.6 19.8)"/>
                    <ellipse cx="34.1" cy="24.2" rx="3.2" ry="4.3" fill="#fff" transform="rotate(20 34.1 24.2)"/>
                </svg>
                <span class="brand-word">PET HEAVEN<small>premium dog gear</small></span>
            </a>

            <!-- Cart stays visible on every screen size, outside the collapsing menu -->
            <div class="d-flex align-items-center gap-2 order-lg-last">
                <button type="button" class="cart-launch" onclick="openCartDrawer()" aria-label="Open cart">
                    <i class="bi bi-bag-fill"></i>
                    <span class="d-none d-sm-inline">Cart</span>
                    <span class="cart-count-chip" id="cartCount">0</span>
                </button>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link @NavActive("/Shop")" asp-page="/Shop"><i class="bi bi-grid-fill me-1"></i>Shop All</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("/DogBed")" asp-page="/DogBed"><i class="bi bi-moon-stars-fill me-1"></i>Dog Beds</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("/Brush")" asp-page="/Brush"><i class="bi bi-stars me-1"></i>Grooming</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("/PawButter")" asp-page="/PawButter"><i class="bi bi-heart-pulse-fill me-1"></i>Paw Care</a></li>
                    <li class="nav-item"><a class="nav-link @NavActive("/BathBrush")" asp-page="/BathBrush"><i class="bi bi-droplet-fill me-1"></i>Bath Time</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand mb-3">
                        <svg class="logo-mark logo-mark-sm" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="1" y="1" width="46" height="46" rx="13" fill="rgba(255,255,255,.12)"/>
                            <ellipse cx="24" cy="9.6" rx="7.6" ry="2.7" fill="none" stroke="#ffc93c" stroke-width="2.4" stroke-linecap="round"/>
                            <path d="M24 39c-4.9 0-8.4-2.7-8.4-6.4 0-3.1 3.6-7.8 8.4-7.8s8.4 4.7 8.4 7.8C32.4 36.3 28.9 39 24 39z" fill="#fff"/>
                            <ellipse cx="13.9" cy="24.2" rx="3.2" ry="4.3" fill="#fff" transform="rotate(-20 13.9 24.2)"/>
                            <ellipse cx="20.4" cy="19.8" rx="3.2" ry="4.5" fill="#fff" transform="rotate(-7 20.4 19.8)"/>
                            <ellipse cx="27.6" cy="19.8" rx="3.2" ry="4.5" fill="#fff" transform="rotate(7 27.6 19.8)"/>
                            <ellipse cx="34.1" cy="24.2" rx="3.2" ry="4.3" fill="#fff" transform="rotate(20 34.1 24.2)"/>
                        </svg>
                        PET HEAVEN
                    </div>
                    <p class="small" style="color:rgba(255,255,255,.65)">
                        Premium comfort, grooming and care — everything your dog needs to live like royalty.
                    </p>
                    <p class="small mb-0" style="color:rgba(255,255,255,.65)">
                        <span style="color:#ffc93c">★★★★★</span> Rated 4.9/5 by verified buyers
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Shop</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/DogBed">Dog Beds</a></li>
                        <li><a asp-page="/Brush">Grooming Brush</a></li>
                        <li><a asp-page="/PawButter">Paw Butter</a></li>
                        <li><a asp-page="/BathBrush">Bath Brush</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Support</h6>
                    <ul class="footer-links">
                        <li><a asp-page="/DogBed" asp-fragment="faq">FAQ</a></li>
                        <li><a asp-page="/Shop">Free Shipping</a></li>
                        <li><a asp-page="/Shop">30-Day Returns</a></li>
                        <li><a href="mailto:n10dee23@gmail.com">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-heading">We accept</h6>
                    <div class="payment-icons">
                        <span><i class="bi bi-credit-card-2-front-fill"></i> Visa</span>
                        <span><i class="bi bi-credit-card-fill"></i> Mastercard</span>
                        <span><i class="bi bi-credit-card"></i> Amex</span>
                        <span><i class="bi bi-apple"></i> Pay</span>
                        <span><i class="bi bi-google"></i> Pay</span>
                    </div>
                    <p class="small mt-3 mb-0" style="color:rgba(255,255,255,.5)">
                        <i class="bi bi-shield-lock me-1"></i>Payments secured by Stripe · 256-bit SSL
                    </p>
                </div>
            </div>
            <hr class="mt-4" />
            <p class="text-center text-muted small mb-0">
                &copy; @DateTime.Now.Year PET HEAVEN. All rights reserved.
                &nbsp;·&nbsp;
                <a asp-page="/Orders" style="color:rgba(255,255,255,.35);text-decoration:none;">Store admin</a>
            </p>
        </div>
    </footer>

    <!-- First-order offer popup -->
    <div class="promo-overlay" id="promoOverlay" role="dialog" aria-modal="true" aria-label="Discount offer">
        <div class="promo-modal">
            <button class="promo-close" id="promoClose" aria-label="Close">&times;</button>
            <div class="promo-emoji">🐾</div>
            <h4>Wait — don't leave empty-pawed!</h4>
            <p>Here's <strong>@promoPct% off</strong> your first order. Use this code at checkout — it stacks with the sale prices.</p>
            <div class="promo-code-box" id="promoCodeBox" title="Click to copy">@promoCode</div>
            <p class="promo-code-hint">Click the code to copy it</p>
            <a asp-page="/Shop" class="btn btn-buy-now w-100 mb-2">Shop the Sale <i class="bi bi-arrow-right ms-1"></i></a>
            <button class="btn btn-link btn-sm text-muted w-100" id="promoDismiss" style="text-decoration:none;font-size:.78rem;">No thanks, my dog has everything</button>
        </div>
    </div>

    <div id="copiedToast">Copied to clipboard ✓</div>

    <!-- Slide-out cart drawer -->
    <div class="offcanvas offcanvas-end cart-drawer" tabindex="-1" id="cartDrawer" aria-label="Shopping cart">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold"><i class="bi bi-bag-fill me-2" style="color:var(--accent);"></i>Your Cart</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" id="cartDrawerBody">
            <div class="text-center text-muted py-5"><div class="spinner-border spinner-border-sm"></div></div>
        </div>
    </div>

    <!-- Site-wide antiforgery token for fetch-based cart calls -->
    <form id="afTokenForm" style="display:none">@Html.AntiForgeryToken()</form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function refreshCartBadge() {
            fetch('/api/cart/count')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('cartCount');
                    if (badge) {
                        badge.textContent = data.count;
                        badge.style.display = data.count > 0 ? 'inline-flex' : 'none';
                    }
                }).catch(() => {});
        }
        refreshCartBadge();

        async function refreshCartDrawer() {
            const body = document.getElementById('cartDrawerBody');
            if (!body) return;
            try {
                const resp = await fetch('/Cart?handler=Drawer');
                if (resp.ok) body.innerHTML = await resp.text();
            } catch (e) { /* keep whatever is shown */ }
        }

        function openCartDrawer() {
            const el = document.getElementById('cartDrawer');
            if (!el || typeof bootstrap === 'undefined') { window.location.href = '/Cart'; return; }
            bootstrap.Offcanvas.getOrCreateInstance(el).show();
            refreshCartDrawer();
        }

        // Called by every add-to-cart on the site: updates the badge and
        // slides the cart open so the shopper sees exactly what happened.
        function cartUpdated(openDrawer = true) {
            refreshCartBadge();
            if (openDrawer) openCartDrawer();
        }

        async function drawerUpdateQty(productId, size, color, qty) {
            const token = document.querySelector('#afTokenForm input[name="__RequestVerificationToken"]')?.value;
            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('size', size);
            fd.append('color', color);
            fd.append('quantity', qty);
            if (token) fd.append('__RequestVerificationToken', token);
            await fetch('/Cart?handler=UpdateCart', {
                method: 'POST', body: fd,
                headers: token ? { 'RequestVerificationToken': token } : {}
            }).catch(() => {});
            refreshCartBadge();
            refreshCartDrawer();
            if (window.location.pathname.toLowerCase().startsWith('/cart')) location.reload();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
