@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div style="font-size:4rem; color:var(--text-muted);" class="mb-3">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h2 class="mb-2">Something went wrong</h2>
    <p class="text-muted mb-4">An unexpected error occurred. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-add-cart px-5">
        <i class="bi bi-house me-2"></i>Back to Home
    </a>
</div>
