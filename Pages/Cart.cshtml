@page
@model CartModel
@{
    ViewData["Title"] = "Your Cart";
}

<div class="container py-5">
    <h1 class="page-title mb-4"><i class="bi bi-bag me-2"></i>Your Cart</h1>

    @if (!Model.Cart.Items.Any())
    {
        <div class="empty-cart text-center py-5">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Your cart is empty</h4>
            <p class="text-muted">Browse our products and find something your pet will love.</p>
            <a asp-page="/Index" class="btn btn-primary mt-3">
                <i class="bi bi-arrow-left me-2"></i>Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-items-card">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="cart-item" data-product="@item.ProductId" data-size="@item.Size" data-color="@item.Color">
                            <div class="cart-item-img">
                                <img src="@item.Image" alt="@item.ProductName"
                                     onerror="this.src='/images/placeholder.svg'" />
                            </div>
                            <div class="cart-item-details flex-grow-1">
                                <h6 class="mb-1">@item.ProductName</h6>
                                <p class="text-muted small mb-2">Size: <strong>@item.Size</strong> (@item.DimensionsCm) · Color: @item.Color</p>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="qty-control-sm">
                                        <button onclick="updateQty(@item.ProductId, '@item.Size', '@item.Color', @(item.Quantity - 1))">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span>@item.Quantity</span>
                                        <button onclick="updateQty(@item.ProductId, '@item.Size', '@item.Color', @(item.Quantity + 1))">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <button class="btn-remove" onclick="updateQty(@item.ProductId, '@item.Size', '@item.Color', 0)">
                                        <i class="bi bi-trash3"></i> Remove
                                    </button>
                                </div>
                            </div>
                            <div class="cart-item-price">
                                <div class="fw-bold">$@item.LineTotal.ToString("F2")</div>
                                <div class="text-muted small">$@item.UnitPrice.ToString("F2") each</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a asp-page="/Index" class="btn-back-shop">
                        <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="order-summary-card">
                    <h5 class="mb-4">Order Summary</h5>
                    <div class="summary-row">
                        <span>Subtotal (@Model.Cart.ItemCount items)</span>
                        <span>$@Model.Cart.Subtotal.ToString("F2")</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span class="text-success fw-semibold">FREE</span>
                    </div>
                    <hr />
                    <div class="summary-row total-row">
                        <span>Total</span>
                        <span>$@Model.Cart.Total.ToString("F2")</span>
                    </div>
                    <a asp-page="/Checkout" class="btn btn-buy-now w-100 mt-3">
                        <i class="bi bi-lock-fill me-2"></i>Secure Checkout
                    </a>
                    <div class="payment-note text-center mt-3">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        <small class="text-muted">256-bit SSL encrypted payment</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<form id="updateCartForm" method="post" asp-page-handler="UpdateCart" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" id="uf_productId" />
    <input type="hidden" name="size" id="uf_size" />
    <input type="hidden" name="color" id="uf_color" />
    <input type="hidden" name="quantity" id="uf_qty" />
</form>

@section Scripts {
<script>
    async function updateQty(productId, size, color, qty) {
        document.getElementById('uf_productId').value = productId;
        document.getElementById('uf_size').value = size;
        document.getElementById('uf_color').value = color;
        document.getElementById('uf_qty').value = qty;
        const form = document.getElementById('updateCartForm');
        const fd = new FormData(form);
        await fetch(form.action, { method: 'POST', body: fd });
        location.reload();
    }
</script>
}
