@page
@model IndexModel
@{
    ViewData["Title"] = "PET HEAVEN — Premium Pet Supplies";
}

<!-- Hero -->
<section style="background:linear-gradient(135deg,#1a3c2e 0%,#2d6a4f 100%);color:#fff;padding:80px 0 60px;">
    <div class="container text-center">
        <p style="letter-spacing:.15em;font-size:.8rem;opacity:.7;text-transform:uppercase;margin-bottom:12px;">Premium Pet Supplies</p>
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:800;margin-bottom:16px;line-height:1.2;">
            Your Pet Deserves the Best
        </h1>
        <p style="font-size:1.1rem;opacity:.85;max-width:520px;margin:0 auto 16px;">
            Hand-picked, premium-quality products for dogs and cats. Free shipping on every single order.
        </p>
        <p style="font-size:.92rem;opacity:.75;margin-bottom:32px;">
            <span style="background:rgba(255,255,255,.15);border-radius:20px;padding:4px 14px;">
                🔥 Sale — up to 70% off, today only
            </span>
        </p>
        <a asp-page="/Shop" class="btn btn-buy-now px-5 py-3" style="font-size:1rem;">
            Shop All Products <i class="bi bi-arrow-right ms-2"></i>
        </a>
        <div class="d-flex justify-content-center gap-4 mt-4" style="font-size:.82rem;opacity:.7;">
            <span><i class="bi bi-truck me-1"></i>Free Shipping</span>
            <span><i class="bi bi-arrow-counterclockwise me-1"></i>30-Day Returns</span>
            <span><i class="bi bi-shield-check me-1"></i>Secure Checkout</span>
        </div>
    </div>
</section>

<!-- Products Grid -->
<section class="py-5">
    <div class="container">
        <h2 class="section-title text-center mb-2">Our Products</h2>
        <p class="text-center text-muted mb-5">Everything your pet needs — free shipping on every order.</p>
        <div class="row g-4 justify-content-center">
            @foreach (var p in Model.AllProducts)
            {
                var url = p.Id == 1 ? "/DogBed" : p.Id == 2 ? "/Brush" : p.Id == 3 ? "/PawButter" : "/BathBrush";
                var img = p.Images.FirstOrDefault() ?? "/images/placeholder.svg";
                var priceLabel = p.Variants.Count == 1
                    ? $"${p.Variants[0].Price:F2}"
                    : $"From ${p.Variants.Min(v => v.Price):F2}";
                var origPriceLabel = p.Variants.Count == 1
                    ? $"${p.Variants[0].OriginalPrice:F2}"
                    : $"From ${p.Variants.Min(v => v.OriginalPrice):F2}";
                var discountPct = (int)Math.Round((1 - p.Variants.Min(v => v.Price) / p.Variants.Min(v => v.OriginalPrice)) * 100);
                <div class="col-sm-6 col-lg-4">
                    <a href="@url" class="text-decoration-none">
                        <div class="shop-card">
                            <div class="shop-card-img" style="position:relative">
                                <img src="@img" alt="@p.Name" onerror="this.src='/images/placeholder.svg'" />
                                @if (discountPct > 0)
                                {
                                    <span class="card-sale-badge">@discountPct% OFF</span>
                                }
                            </div>
                            <div class="shop-card-body">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    @for (int i = 1; i <= 5; i++) { <i class="bi bi-star-fill text-warning" style="font-size:.7rem"></i> }
                                    <span class="text-muted small ms-1">(@p.ReviewCount)</span>
                                </div>
                                <h6 class="shop-card-title">@p.Name</h6>
                                <p class="shop-card-desc">@p.ShortDescription</p>
                                <div class="d-flex align-items-center justify-content-between mt-3">
                                    <div>
                                        <span class="shop-card-price">@priceLabel</span>
                                        <span style="text-decoration:line-through;color:#aaa;font-size:.78rem;margin-left:5px;">@origPriceLabel</span>
                                    </div>
                                    <span class="btn btn-buy-now btn-sm px-3 py-2" style="font-size:.82rem">Shop Now</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why PET HEAVEN -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="section-title text-center mb-2">Why PET HEAVEN?</h2>
        <p class="text-center text-muted mb-5">We obsess over every detail so your pet doesn't have to settle.</p>
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="bi bi-truck"></i></div>
                    <h6>Free Shipping</h6>
                    <p>Every order ships free, no minimum required.</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
                    <h6>30-Day Returns</h6>
                    <p>Not happy? Full refund, no questions asked.</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="bi bi-shield-lock"></i></div>
                    <h6>Secure Payment</h6>
                    <p>Powered by Stripe — your card details are always safe.</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="feature-card">
                    <div class="feature-icon"><i class="bi bi-award"></i></div>
                    <h6>Premium Quality</h6>
                    <p>Every product is carefully tested and pet-safe.</p>
                </div>
            </div>
        </div>
    </div>
</section>
