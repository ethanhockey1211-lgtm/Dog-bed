@page
@model SuccessModel
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5">
    <div class="confirmation-card text-center">
        <div class="confirm-icon mb-3">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2 class="mb-2">Order confirmed — happy dog incoming! 🎉</h2>
        <p class="text-muted mb-1">
            A confirmation email is on its way to
            <strong>@(Model.CustomerEmail ?? "your inbox")</strong>.
        </p>

        <div class="next-steps mt-4">
            <div class="next-step">
                <span class="n">1</span>
                <div>
                    <h6>Order received</h6>
                    <p>We've got it and your payment is confirmed.</p>
                </div>
            </div>
            <div class="next-step">
                <span class="n">2</span>
                <div>
                    <h6>Packed &amp; shipped within 1–3 business days</h6>
                    <p>You'll get a shipping email with tracking as soon as it's on the move.</p>
                </div>
            </div>
            <div class="next-step">
                <span class="n">3</span>
                <div>
                    <h6>Tail wags guaranteed</h6>
                    <p>Not loving it? You have 30 days for a full refund — no questions asked.</p>
                </div>
            </div>
        </div>

        <div class="confirm-details mt-4 mb-4">
            <div class="confirm-detail-row">
                <span>Order reference</span>
                <span><strong>#PH-@Model.OrderRef</strong></span>
            </div>
            <div class="confirm-detail-row">
                <span>Estimated delivery</span>
                <span><strong>@DateTime.Now.AddDays(7).ToString("MMMM d") – @DateTime.Now.AddDays(14).ToString("MMMM d, yyyy")</strong></span>
            </div>
            @if (Model.Order != null)
            {
                <div class="confirm-detail-row">
                    <span>Amount paid</span>
                    <span><strong>$@Model.Order.AmountPaid.ToString("F2")</strong></span>
                </div>
                <div class="confirm-detail-row">
                    <span>Ship to</span>
                    <span><strong>@Model.Order.Address, @Model.Order.City @Model.Order.ZipCode</strong></span>
                </div>
            }
        </div>

        <a asp-page="/Shop" class="btn btn-add-cart px-5">
            <i class="bi bi-bag me-2"></i>Keep Shopping the Sale
        </a>
    </div>
</div>

@if (Model.Order != null)
{
    var contents = Model.Order.Items.Select(i => new {
        id = i.ProductId.ToString(),
        quantity = i.Quantity,
        item_price = i.UnitPrice
    });
    <script>
        fbq('track', 'Purchase', {
            value: @Model.Order.AmountPaid.ToString("F2"),
            currency: 'USD',
            content_type: 'product',
            content_ids: [@string.Join(",", Model.Order.Items.Select(i => $"'{i.ProductId}'"))],
            contents: @System.Text.Json.JsonSerializer.Serialize(contents),
            num_items: @Model.Order.Items.Sum(i => i.Quantity)
        });
    </script>
}
