@page
@model ShopModel
@{
    ViewData["Title"] = "Shop — PET HEAVEN";
}

<div class="container py-5">
    <h1 class="page-title text-center mb-2">Our Products</h1>
    <p class="text-center text-muted mb-5">Premium pet supplies — free shipping on every order.</p>

    <div class="row g-4">
        @foreach (var p in Model.Products)
        {
            <div class="col-sm-6 col-lg-4">
                <a href="@p.Url" class="text-decoration-none">
                    <div class="shop-card">
                        <div class="shop-card-img">
                            <img src="@p.Image" alt="@p.Name" onerror="this.src='/images/placeholder.svg'" />
                        </div>
                        <div class="shop-card-body">
                            <div class="d-flex align-items-center gap-1 mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill text-warning" style="font-size:.7rem"></i>
                                }
                                <span class="text-muted small ms-1">(@p.ReviewCount)</span>
                            </div>
                            <h6 class="shop-card-title">@p.Name</h6>
                            <p class="shop-card-desc">@p.ShortDescription</p>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <span class="shop-card-price">@p.PriceLabel</span>
                                <span class="btn btn-buy-now btn-sm px-3 py-2" style="font-size:.82rem">Shop Now</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
