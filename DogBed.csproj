<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DogBed</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Stripe.net" Version="46.2.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

  <!--
    Playwright browser install — runs once after build.
    If this step fails, open a terminal in the project folder and run:
      dotnet build
      pwsh bin\Debug\net9.0\playwright.ps1 install chromium
  -->
  <!-- Skip browser install in Docker/CI; run manually on dev machines -->
  <Target Name="InstallPlaywrightBrowsers" AfterTargets="Build"
          Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != 'true' AND '$(CI)' != 'true'">
    <Exec Command="pwsh $(OutputPath)playwright.ps1 install chromium"
          ContinueOnError="true"
          StandardOutputImportance="Low" />
  </Target>

</Project>
